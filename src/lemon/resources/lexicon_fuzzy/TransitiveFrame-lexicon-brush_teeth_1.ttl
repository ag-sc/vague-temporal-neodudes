@prefix :        <http://localhost:8000/lexicon#> .

@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lemon:   <http://localhost:8000/lemon.owl#> .

@base            <http://localhost:8000#> .

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:lexicon_en a    lemon:Lexicon ;
  lemon:language "en" ;
  lemon:entry    :to_brush_teeth_1 ;
  lemon:entry    :form_brush_teeth_1_preposition .

:to_brush_teeth_1 a           lemon:LexicalEntry ;
  lexinfo:partOfSpeech lexinfo:verb ;
  lemon:canonicalForm  :form_brush_teeth_1 ;
  lemon:otherForm      :form_brush_teeth_1s ;
  lemon:otherForm      :form_brush_teeth_1ed ;
  lemon:otherForm      :form_brush_teeth_1perfect ;
  lemon:sense          :brush_teeth_1_sense_1 ;
  lemon:synBehavior    :brush_teeth_1_frame_transitive .

:form_brush_teeth_1 a         lemon:Form ;
  lemon:writtenRep     "brush teeth"@en ;
  lexinfo:verbFormMood lexinfo:infinitive .

:form_brush_teeth_1s a    lemon:Form ;
  lemon:writtenRep "brushes teeth"@en ;
  lexinfo:person   lexinfo:secondPerson .

:form_brush_teeth_1ed a   lemon:Form ;
  lemon:writtenRep "brushed teeth"@en ;
  lexinfo:tense    lexinfo:past .

:form_brush_teeth_1perfect a   lemon:Form ;
  lemon:writtenRep "brushed teeth"@en ;
  lexinfo:tense    lexinfo:perfect ;
  lexinfo:person   lexinfo:thirdPerson .

:brush_teeth_1_frame_transitive a lexinfo:IntransitivePPFrame ;
  lexinfo:subject          :brush_teeth_1_subj ;
  lexinfo:directObject     :brush_teeth_1_obj .

:brush_teeth_1_sense_1 a   lemon:OntoMap, lemon:LexicalSense ;
  lemon:ontoMapping :brush_teeth_1_sense_1 ;
  lemon:reference   dul:hasAgent ;
  lemon:subjOfProp  :brush_teeth_1_obj ;
  lemon:objOfProp   :brush_teeth_1_subj ;
  lemon:condition   :brush_teeth_1_sense_1_condition .


:brush_teeth_1_sense_1_condition a    lemon:condition ;
  lemon:propertyDomain ex:Personal_Hygiene ;
  lemon:propertyRange  dul:Agent .

:brush_teeth_1_obj lemon:marker :form_brush_teeth_1_preposition .

## Prepositions ##
:form_brush_teeth_1_preposition a                  lemon:SynRoleMarker ;
  lemon:canonicalForm  [ lemon:writtenRep "with"@en ] ;
  lexinfo:partOfSpeech lexinfo:preposition .

