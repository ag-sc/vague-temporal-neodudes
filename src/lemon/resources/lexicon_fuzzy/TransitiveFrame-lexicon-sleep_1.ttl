@prefix :        <http://localhost:8000/lexicon#> .

@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lemon:   <http://localhost:8000/lemon.owl#> .

@base            <http://localhost:8000#> .

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:lexicon_en a    lemon:Lexicon ;
  lemon:language "en" ;
  lemon:entry    :to_sleep_1 ;
  lemon:entry    :form_sleep_1_preposition .

:to_sleep_1 a           lemon:LexicalEntry ;
  lexinfo:partOfSpeech lexinfo:verb ;
  lemon:canonicalForm  :form_sleep_1 ;
  lemon:otherForm      :form_sleep_1s ;
  lemon:otherForm      :form_sleep_1ed ;
  lemon:otherForm      :form_sleep_1perfect ;
  lemon:sense          :sleep_1_sense_1 ;
  lemon:synBehavior    :sleep_1_frame_transitive .

:form_sleep_1 a         lemon:Form ;
  lemon:writtenRep     "sleep"@en ;
  lexinfo:verbFormMood lexinfo:infinitive .

:form_sleep_1s a    lemon:Form ;
  lemon:writtenRep "sleeps"@en ;
  lexinfo:person   lexinfo:secondPerson .

:form_sleep_1ed a   lemon:Form ;
  lemon:writtenRep "slept"@en ;
  lexinfo:tense    lexinfo:past .

:form_sleep_1perfect a   lemon:Form ;
  lemon:writtenRep "slept"@en ;
  lexinfo:tense    lexinfo:perfect ;
  lexinfo:person   lexinfo:thirdPerson .

:sleep_1_frame_transitive a lexinfo:IntransitivePPFrame ;
  lexinfo:subject          :sleep_1_subj ;
  lexinfo:directObject     :sleep_1_obj .

:sleep_1_sense_1 a   lemon:OntoMap, lemon:LexicalSense ;
  lemon:ontoMapping :sleep_1_sense_1 ;
  lemon:reference   dul:hasAgent ;
  lemon:subjOfProp  :sleep_1_obj ;
  lemon:objOfProp   :sleep_1_subj ;
  lemon:condition   :sleep_1_sense_1_condition .


:sleep_1_sense_1_condition a    lemon:condition ;
  lemon:propertyDomain ex:Sleep ;
  lemon:propertyRange  dul:Agent .

:sleep_1_obj lemon:marker :form_sleep_1_preposition .

## Prepositions ##
:form_sleep_1_preposition a                  lemon:SynRoleMarker ;
  lemon:canonicalForm  [ lemon:writtenRep "with"@en ] ;
  lexinfo:partOfSpeech lexinfo:preposition .

