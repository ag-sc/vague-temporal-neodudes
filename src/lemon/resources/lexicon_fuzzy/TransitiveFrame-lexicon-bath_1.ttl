@prefix :        <http://localhost:8000/lexicon#> .

@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lemon:   <http://localhost:8000/lemon.owl#> .

@base            <http://localhost:8000#> .

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:lexicon_en a    lemon:Lexicon ;
  lemon:language "en" ;
  lemon:entry    :to_bath_1 ;
  lemon:entry    :form_bath_1_preposition .

:to_bath_1 a           lemon:LexicalEntry ;
  lexinfo:partOfSpeech lexinfo:verb ;
  lemon:canonicalForm  :form_bath_1 ;
  lemon:otherForm      :form_bath_1s ;
  lemon:otherForm      :form_bath_1ed ;
  lemon:otherForm      :form_bath_1perfect ;
  lemon:sense          :bath_1_sense_1 ;
  lemon:synBehavior    :bath_1_frame_transitive .

:form_bath_1 a         lemon:Form ;
  lemon:writtenRep     "take a bath"@en ;
  lexinfo:verbFormMood lexinfo:infinitive .

:form_bath_1s a    lemon:Form ;
  lemon:writtenRep "takes a bath"@en ;
  lexinfo:person   lexinfo:secondPerson .

:form_bath_1ed a   lemon:Form ;
  lemon:writtenRep "took a bath"@en ;
  lexinfo:tense    lexinfo:past .

:form_bath_1perfect a   lemon:Form ;
  lemon:writtenRep "taken a bath"@en ;
  lexinfo:tense    lexinfo:perfect ;
  lexinfo:person   lexinfo:thirdPerson .

:bath_1_frame_transitive a lexinfo:IntransitivePPFrame ;
  lexinfo:subject          :bath_1_subj ;
  lexinfo:directObject     :bath_1_obj .

:bath_1_sense_1 a   lemon:OntoMap, lemon:LexicalSense ;
  lemon:ontoMapping :bath_1_sense_1 ;
  lemon:reference   dul:hasAgent ;
  lemon:subjOfProp  :bath_1_obj ;
  lemon:objOfProp   :bath_1_subj ;
  lemon:condition   :bath_1_sense_1_condition .


:bath_1_sense_1_condition a    lemon:condition ;
  lemon:propertyDomain ex:Bathing ;
  lemon:propertyRange  dul:Agent .

:bath_1_obj lemon:marker :form_bath_1_preposition .

## Prepositions ##
:form_bath_1_preposition a                  lemon:SynRoleMarker ;
  lemon:canonicalForm  [ lemon:writtenRep "with"@en ] ;
  lexinfo:partOfSpeech lexinfo:preposition .

