@prefix :        <http://localhost:8000/lexicon#> .

@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lemon:   <http://localhost:8000/lemon.owl#> .

@base            <http://localhost:8000#> .

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:lexicon_en a    lemon:Lexicon ;
  lemon:language "en" ;
  lemon:entry    :to_eat_1 ;
  lemon:entry    :form_eat_1_preposition .

:to_eat_1 a           lemon:LexicalEntry ;
  lexinfo:partOfSpeech lexinfo:verb ;
  lemon:canonicalForm  :form_eat_1 ;
  lemon:otherForm      :form_eat_1s ;
  lemon:otherForm      :form_eat_1ed ;
  lemon:otherForm      :form_eat_1perfect ;
  lemon:sense          :eat_1_sense_1 ;
  lemon:synBehavior    :eat_1_frame_transitive .

:form_eat_1 a         lemon:Form ;
  lemon:writtenRep     "eat"@en ;
  lexinfo:verbFormMood lexinfo:infinitive .

:form_eat_1s a    lemon:Form ;
  lemon:writtenRep "eats"@en ;
  lexinfo:person   lexinfo:secondPerson .

:form_eat_1ed a   lemon:Form ;
  lemon:writtenRep "ate"@en ;
  lexinfo:tense    lexinfo:past .

:form_eat_1perfect a   lemon:Form ;
  lemon:writtenRep "eaten"@en ;
  lexinfo:tense    lexinfo:perfect ;
  lexinfo:person   lexinfo:thirdPerson .

:eat_1_frame_transitive a lexinfo:IntransitivePPFrame ;
  lexinfo:subject          :eat_1_subj ;
  lexinfo:directObject     :eat_1_obj .

:eat_1_sense_1 a   lemon:OntoMap, lemon:LexicalSense ;
  lemon:ontoMapping :eat_1_sense_1 ;
  lemon:reference   dul:hasAgent ;
  lemon:subjOfProp  :eat_1_obj ;
  lemon:objOfProp   :eat_1_subj ;
  lemon:condition   :eat_1_sense_1_condition .


:eat_1_sense_1_condition a    lemon:condition ;
  lemon:propertyDomain ex:Eating ;
  lemon:propertyRange  dul:Agent .

:eat_1_obj lemon:marker :form_eat_1_preposition .

## Prepositions ##
:form_eat_1_preposition a                  lemon:SynRoleMarker ;
  lemon:canonicalForm  [ lemon:writtenRep "with"@en ] ;
  lexinfo:partOfSpeech lexinfo:preposition .

