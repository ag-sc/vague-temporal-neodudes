@prefix :        <http://localhost:8000/lexicon#> .

@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lemon:   <http://localhost:8000/lemon.owl#> .

@base            <http://localhost:8000#> .

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:lexicon_en a    lemon:Lexicon ;
  lemon:language "en" ;
  lemon:entry    :to_return_1 ;
  lemon:entry    :form_return_1_preposition .

:to_return_1 a           lemon:LexicalEntry ;
  lexinfo:partOfSpeech lexinfo:verb ;
  lemon:canonicalForm  :form_return_1 ;
  lemon:otherForm      :form_return_1s ;
  lemon:otherForm      :form_return_1ed ;
  lemon:otherForm      :form_return_1perfect ;
  lemon:sense          :return_1_sense_1 ;
  lemon:synBehavior    :return_1_frame_transitive .

:form_return_1 a         lemon:Form ;
  lemon:writtenRep     "return home"@en ;
  lexinfo:verbFormMood lexinfo:infinitive .

:form_return_1s a    lemon:Form ;
  lemon:writtenRep "returns home"@en ;
  lexinfo:person   lexinfo:secondPerson .

:form_return_1ed a   lemon:Form ;
  lemon:writtenRep "returned home"@en ;
  lexinfo:tense    lexinfo:past .

:form_return_1perfect a   lemon:Form ;
  lemon:writtenRep "returned home"@en ;
  lexinfo:tense    lexinfo:perfect ;
  lexinfo:person   lexinfo:thirdPerson .

:return_1_frame_transitive a lexinfo:IntransitivePPFrame ;
  lexinfo:subject          :return_1_subj ;
  lexinfo:directObject     :return_1_obj .

:return_1_sense_1 a   lemon:OntoMap, lemon:LexicalSense ;
  lemon:ontoMapping :return_1_sense_1 ;
  lemon:reference   dul:hasAgent ;
  lemon:subjOfProp  :return_1_obj ;
  lemon:objOfProp   :return_1_subj ;
  lemon:condition   :return_1_sense_1_condition .


:return_1_sense_1_condition a    lemon:condition ;
  lemon:propertyDomain ex:Out_of_Home ;
  lemon:propertyRange  dul:Agent .

:return_1_obj lemon:marker :form_return_1_preposition .

## Prepositions ##
:form_return_1_preposition a                  lemon:SynRoleMarker ;
  lemon:canonicalForm  [ lemon:writtenRep "with"@en ] ;
  lexinfo:partOfSpeech lexinfo:preposition .

