@prefix :        <http://localhost:8000/lexicon#> .

@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lemon:   <http://localhost:8000/lemon.owl#> .

@base            <http://localhost:8000#> .

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:lexicon_en a    lemon:Lexicon ;
  lemon:language "en" ;
  lemon:entry    :to_hygiene_1 ;
  lemon:entry    :form_hygiene_1_preposition .

:to_hygiene_1 a           lemon:LexicalEntry ;
  lexinfo:partOfSpeech lexinfo:verb ;
  lemon:canonicalForm  :form_hygiene_1 ;
  lemon:otherForm      :form_hygiene_1s ;
  lemon:otherForm      :form_hygiene_1ed ;
  lemon:otherForm      :form_hygiene_1perfect ;
  lemon:sense          :hygiene_1_sense_1 ;
  lemon:synBehavior    :hygiene_1_frame_transitive .

:form_hygiene_1 a         lemon:Form ;
  lemon:writtenRep     "take care of personal hygiene"@en ;
  lexinfo:verbFormMood lexinfo:infinitive .

:form_hygiene_1s a    lemon:Form ;
  lemon:writtenRep "takes care of personal hygiene"@en ;
  lexinfo:person   lexinfo:secondPerson .

:form_hygiene_1ed a   lemon:Form ;
  lemon:writtenRep "took care of personal hygiene"@en ;
  lexinfo:tense    lexinfo:past .

:form_hygiene_1perfect a   lemon:Form ;
  lemon:writtenRep "taken care of personal hygiene"@en ;
  lexinfo:tense    lexinfo:perfect ;
  lexinfo:person   lexinfo:thirdPerson .

:hygiene_1_frame_transitive a lexinfo:IntransitivePPFrame ;
  lexinfo:subject          :hygiene_1_subj ;
  lexinfo:directObject     :hygiene_1_obj .

:hygiene_1_sense_1 a   lemon:OntoMap, lemon:LexicalSense ;
  lemon:ontoMapping :hygiene_1_sense_1 ;
  lemon:reference   dul:hasAgent ;
  lemon:subjOfProp  :hygiene_1_obj ;
  lemon:objOfProp   :hygiene_1_subj ;
  lemon:condition   :hygiene_1_sense_1_condition .


:hygiene_1_sense_1_condition a    lemon:condition ;
  lemon:propertyDomain ex:Personal_Hygiene ;
  lemon:propertyRange  dul:Agent .

:hygiene_1_obj lemon:marker :form_hygiene_1_preposition .

## Prepositions ##
:form_hygiene_1_preposition a                  lemon:SynRoleMarker ;
  lemon:canonicalForm  [ lemon:writtenRep "with"@en ] ;
  lexinfo:partOfSpeech lexinfo:preposition .

