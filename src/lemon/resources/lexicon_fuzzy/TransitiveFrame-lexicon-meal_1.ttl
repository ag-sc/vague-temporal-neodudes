@prefix :        <http://localhost:8000/lexicon#> .

@prefix lexinfo: <http://www.lexinfo.net/ontology/2.0/lexinfo#> .
@prefix lemon:   <http://localhost:8000/lemon.owl#> .

@base            <http://localhost:8000#> .

@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:lexicon_en a    lemon:Lexicon ;
  lemon:language "en" ;
  lemon:entry    :to_meal_1 ;
  lemon:entry    :form_meal_1_preposition .

:to_meal_1 a           lemon:LexicalEntry ;
  lexinfo:partOfSpeech lexinfo:verb ;
  lemon:canonicalForm  :form_meal_1 ;
  lemon:otherForm      :form_meal_1s ;
  lemon:otherForm      :form_meal_1ed ;
  lemon:otherForm      :form_meal_1perfect ;
  lemon:sense          :meal_1_sense_1 ;
  lemon:synBehavior    :meal_1_frame_transitive .

:form_meal_1 a         lemon:Form ;
  lemon:writtenRep     "do meal preparation"@en ;
  lexinfo:verbFormMood lexinfo:infinitive .

:form_meal_1s a    lemon:Form ;
  lemon:writtenRep "does meal preparation"@en ;
  lexinfo:person   lexinfo:secondPerson .

:form_meal_1ed a   lemon:Form ;
  lemon:writtenRep "did meal preparation"@en ;
  lexinfo:tense    lexinfo:past .

:form_meal_1perfect a   lemon:Form ;
  lemon:writtenRep "done meal preparation"@en ;
  lexinfo:tense    lexinfo:perfect ;
  lexinfo:person   lexinfo:thirdPerson .

:meal_1_frame_transitive a lexinfo:IntransitivePPFrame ;
  lexinfo:subject          :meal_1_subj ;
  lexinfo:directObject     :meal_1_obj .

:meal_1_sense_1 a   lemon:OntoMap, lemon:LexicalSense ;
  lemon:ontoMapping :meal_1_sense_1 ;
  lemon:reference   dul:hasAgent ;
  lemon:subjOfProp  :meal_1_obj ;
  lemon:objOfProp   :meal_1_subj ;
  lemon:condition   :meal_1_sense_1_condition .


:meal_1_sense_1_condition a    lemon:condition ;
  lemon:propertyDomain ex:Meal_Preparation ;
  lemon:propertyRange  dul:Agent .

:meal_1_obj lemon:marker :form_meal_1_preposition .

## Prepositions ##
:form_meal_1_preposition a                  lemon:SynRoleMarker ;
  lemon:canonicalForm  [ lemon:writtenRep "with"@en ] ;
  lexinfo:partOfSpeech lexinfo:preposition .

